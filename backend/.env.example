PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sign-shop
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
# Used to build links in emails (password reset, etc.)
FRONTEND_URL=http://localhost:5173
# Used to build this server's own OAuth redirect/callback URLs (Dropbox,
# Google Drive). Must be reachable from the outside world for OAuth to
# work, so a local dev tunnel (ngrok, etc.) is needed to test those flows
# from localhost — plain localhost works for everything else.
BACKEND_URL=http://localhost:4000

# Internal file storage: Cloudflare R2. Leave all four unset to fall back
# to local disk automatically (dev/local only — never appropriate in
# production, since Render's filesystem doesn't survive a redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Shop-level Dropbox connection (set via Settings/OAuth at runtime; these are app credentials)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Shop-level Google Drive connection (same idea as Dropbox above)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform billing (Stripe) — leave unset to disable billing links entirely.
# Price IDs come from Products/Prices you create in the Stripe dashboard for
# the three plan tiers ($59.99 / $119.99 / $199.99 per month).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Recurring $9.99/mo Price for the +25GB storage add-on, purchasable by any
# shop regardless of tier. Leave unset to fall back to the dummy checkout.
STRIPE_PRICE_STORAGE_ADDON=

# Shop-level Stripe Connect — lets shops collect their own customer
# payments; the platform never touches this money. Uses the same
# STRIPE_SECRET_KEY above plus a Connect client_id from the platform's
# Stripe Connect settings. Leave STRIPE_CONNECT_CLIENT_ID unset to fall
# back to a dummy connect/charge flow for testing without a real account.
STRIPE_CONNECT_CLIENT_ID=
# Separate from STRIPE_WEBHOOK_SECRET — Connect events need their own
# webhook endpoint registered in Stripe's Connect webhook settings.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Publishable key (starts with pk_) for the in-person "charge a card"
# form — Stripe Elements needs this client-side to tokenize a manually
# keyed-in card. Safe to expose to the browser; it's not a secret. Leave
# unset to fall back to the dummy in-person charge flow.
STRIPE_PUBLISHABLE_KEY=

# Shop-level Square connection — same idea as Stripe Connect above, using
# Square's own OAuth app credentials from the Square Developer Dashboard.
# SQUARE_ENV defaults to sandbox; set to "production" to go live.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENV=sandbox

# Shop-level PayPal connection via PayPal's Partner Referrals API — these
# are the *platform's* partner credentials (PayPal Partner/Commerce
# Platform), never a shop's own login. PAYPAL_ENV defaults to sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Real email notifications (password reset, order updates, messages) — any
# SMTP account works (Gmail, Postmark, SES, SendGrid's SMTP relay, etc.).
# Leave SMTP_HOST unset to fall back to logging emails to the server
# console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Real SMS notifications via Twilio — leave unset to fall back to logging
# texts to the server console. Get these from a Twilio account (Console →
# Account Info for the SID/token, Phone Numbers for a number to text from).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
