PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sign-shop
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173

# Internal file storage (S3 / Cloudflare R2 compatible)
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_ENDPOINT=

# Shop-level Dropbox connection (set via Settings/OAuth at runtime; these are app credentials)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
