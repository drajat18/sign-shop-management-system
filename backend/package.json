{
  "name": "sign-shop-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "provision-shop": "tsx src/scripts/provisionShop.ts",
    "migrate": "tsx src/scripts/runMigrations.ts",
